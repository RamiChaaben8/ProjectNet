@page "/admin/articles/add"
@inject FrontEnd.Services.ArticleService ArticleService
@inject FrontEnd.Services.CategoryService CategoryService
@inject NavigationManager NavigationManager
@using FrontEnd.Models

<div class="restaurant-admin-container">
    <div class="page-header">
        <h3><i class="bi bi-egg-fried"></i> Add New Menu Item</h3>
        <p class="subtitle">Add a delicious new dish to your restaurant menu</p>
    </div>

    @if (categories == null)
    {
        <div class="loading-state">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading categories...</p>
        </div>
    }
    else
    {
        <div class="restaurant-card">
            <EditForm Model="@newArticle" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="form-grid">
                    <div class="form-section full-width">
                        <label for="name" class="restaurant-label">
                            <i class="bi bi-cup-hot"></i> Dish Name
                        </label>
                        <InputText id="name" class="restaurant-input" placeholder="e.g., Margherita Pizza" @bind-Value="newArticle.Name" />
                        <ValidationMessage For="@(() => newArticle.Name)" class="validation-error" />
                    </div>

                    <div class="form-section full-width">
                        <label for="description" class="restaurant-label">
                            <i class="bi bi-card-text"></i> Description
                        </label>
                        <InputTextArea id="description" class="restaurant-textarea" rows="4" 
                                       placeholder="Describe the ingredients and flavors..." 
                                       @bind-Value="newArticle.Description" />
                        <ValidationMessage For="@(() => newArticle.Description)" class="validation-error" />
                    </div>

                    <div class="form-section">
                        <label for="price" class="restaurant-label">
                            <i class="bi bi-currency-dollar"></i> Price
                        </label>
                        <InputNumber id="price" class="restaurant-input" placeholder="0.00" @bind-Value="newArticle.Price" />
                        <ValidationMessage For="@(() => newArticle.Price)" class="validation-error" />
                    </div>

                    <div class="form-section">
                        <label for="category" class="restaurant-label">
                            <i class="bi bi-bookmark"></i> Category
                        </label>
                        <InputSelect id="category" class="restaurant-select" @bind-Value="newArticle.CategoryID">
                            <option value="0">-- Select Category --</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryID">@category.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => newArticle.CategoryID)" class="validation-error" />
                    </div>

                    <div class="form-section full-width">
                        <label for="imageUrl" class="restaurant-label">
                            <i class="bi bi-image"></i> Image URL (Optional)
                        </label>
                        <InputText id="imageUrl" class="restaurant-input" 
                                   placeholder="https://example.com/dish-image.jpg" 
                                   @bind-Value="newArticle.ImageUrl" />
                        <small class="form-text">Paste a URL to an image of the dish</small>
                    </div>

                    @if (!string.IsNullOrEmpty(newArticle.ImageUrl))
                    {
                        <div class="form-section full-width">
                            <div class="image-preview">
                                <img src="@newArticle.ImageUrl" alt="Preview" />
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-exclamation-triangle"></i> @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i> @successMessage
                    </div>
                }

                <div class="action-buttons">
                    <button type="submit" class="btn-restaurant-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-plus-circle"></i> Add to Menu
                    </button>
                    <button type="button" class="btn-restaurant-secondary" @onclick="Cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

<style>
    .restaurant-admin-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        color: #2c3e50;
    }

    .page-header h3 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #d35400;
    }

    .page-header .subtitle {
        color: #7f8c8d;
        font-size: 16px;
    }

    .restaurant-card {
        background: white;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .form-section.full-width {
        grid-column: 1 / -1;
    }

    .restaurant-label {
        display: block;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 15px;
    }

    .restaurant-label i {
        color: #e67e22;
        margin-right: 8px;
    }

    .restaurant-input,
    .restaurant-textarea,
    .restaurant-select {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #ecf0f1;
        border-radius: 8px;
        font-size: 15px;
        transition: all 0.3s;
    }

    .restaurant-input:focus,
    .restaurant-textarea:focus,
    .restaurant-select:focus {
        outline: none;
        border-color: #e67e22;
        box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.1);
    }

    .form-text {
        display: block;
        margin-top: 5px;
        color: #95a5a6;
        font-size: 13px;
    }

    .image-preview {
        margin-top: 10px;
        border-radius: 10px;
        overflow: hidden;
        max-height: 300px;
        display: flex;
        justify-content: center;
        background: #f8f9fa;
    }

    .image-preview img {
        max-width: 100%;
        max-height: 300px;
        object-fit: cover;
    }

    .validation-error {
        color: #e74c3c;
        font-size: 13px;
        margin-top: 5px;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        justify-content: center;
    }

    .btn-restaurant-primary,
    .btn-restaurant-secondary {
        padding: 14px 30px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-restaurant-primary {
        background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
        color: white;
    }

    .btn-restaurant-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(230, 126, 34, 0.3);
    }

    .btn-restaurant-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-restaurant-secondary {
        background: #ecf0f1;
        color: #2c3e50;
    }

    .btn-restaurant-secondary:hover {
        background: #bdc3c7;
    }

    .loading-state {
        text-align: center;
        padding: 60px 20px;
        color: #7f8c8d;
    }

    .loading-state .spinner-border {
        width: 3rem;
        height: 3rem;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .restaurant-card {
            padding: 25px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-restaurant-primary,
        .btn-restaurant-secondary {
            width: 100%;
        }
    }
</style>

@code {
    private AddArticleDTO newArticle = new AddArticleDTO();
    private List<Category> categories;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await CategoryService.GetCategories();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Convert DTO to Article entity
            var article = new Article
            {
                Name = newArticle.Name,
                Description = newArticle.Description,
                Price = newArticle.Price,
                CategoryID = newArticle.CategoryID,
                ImageUrl = newArticle.ImageUrl,
                Category = null  // Explicitly set to null to avoid validation error
            };

            var success = await ArticleService.CreateArticle(article);
            
            if (success)
            {
                successMessage = "Menu item added successfully!";
                await Task.Delay(1500); // Show success message briefly
                NavigationManager.NavigateTo("/admin/articles");
            }
            else
            {
                errorMessage = "Failed to add menu item. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/articles");
    }
}
