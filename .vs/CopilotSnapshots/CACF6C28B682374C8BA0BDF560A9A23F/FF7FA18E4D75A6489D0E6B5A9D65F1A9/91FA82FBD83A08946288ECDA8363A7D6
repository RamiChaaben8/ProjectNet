@page "/admin/articles/edit/{id:int}"
@inject FrontEnd.Services.ArticleService ArticleService
@inject FrontEnd.Services.CategoryService CategoryService
@inject NavigationManager NavigationManager
@using FrontEnd.Models

<h3>Edit Article</h3>

@if (article == null || categories == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <EditForm Model="@article" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Article Name</label>
                    <InputText id="name" class="form-control" @bind-Value="article.Name" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <InputTextArea id="description" class="form-control" rows="4" @bind-Value="article.Description" />
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <InputNumber id="price" class="form-control" @bind-Value="article.Price" />
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <InputSelect id="category" class="form-control" @bind-Value="article.CategoryID">
                        <option value="0">-- Select Category --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryID">@category.Name</option>
                        }
                    </InputSelect>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Update Article
                    </button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Article article;
    private List<Category> categories;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load both article and categories in parallel
            var articleTask = ArticleService.GetArticleById(Id);
            var categoriesTask = CategoryService.GetCategories();

            await Task.WhenAll(articleTask, categoriesTask);

            article = await articleTask;
            categories = await categoriesTask;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Set Category to null to avoid validation error
            article.Category = null;
            
            var success = await ArticleService.UpdateArticle(article);
            
            if (success)
            {
                successMessage = "Article updated successfully!";
                await Task.Delay(1500); // Show success message briefly
                NavigationManager.NavigateTo("/admin/articles");
            }
            else
            {
                errorMessage = "Failed to update article. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/articles");
    }
}
