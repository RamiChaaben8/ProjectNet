@page "/admin/orders"
@using FrontEnd.Models
@using FrontEnd.Services
@inject OrderService OrderService
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h3>Order Management</h3>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentTab == "pending" ? "active" : "")" @onclick='() => NavigateToTab("pending")' style="cursor: pointer;">
            <i class="bi bi-clock-history"></i> Pending
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentTab == "done" ? "active" : "")" @onclick='() => NavigateToTab("done")' style="cursor: pointer;">
            <i class="bi bi-check-circle"></i> Accepted
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentTab == "declined" ? "active" : "")" @onclick='() => NavigateToTab("declined")' style="cursor: pointer;">
            <i class="bi bi-x-circle"></i> Declined
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentTab == "all" ? "active" : "")" @onclick='() => NavigateToTab("all")' style="cursor: pointer;">
            <i class="bi bi-list"></i> All Orders
        </a>
    </li>
</ul>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else if (!filteredOrders.Any())
{
    <p><em>No orders found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Client Email</th>
                <th>Client Name</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in filteredOrders)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.OrderDate.ToShortDateString()</td>
                    <td>@order.ClientEmail</td>
                    <td>@order.ClientName</td>
                    <td>$@order.TotalPrice.ToString("F2")</td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <span class="badge bg-warning">@order.Status</span>
                        }
                        else if (order.Status == "Accepted")
                        {
                            <span class="badge bg-success">@order.Status</span>
                        }
                        else if (order.Status == "Declined")
                        {
                            <span class="badge bg-danger">@order.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@order.Status</span>
                        }
                    </td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <button class="btn btn-success btn-sm me-2" @onclick="() => AcceptOrder(order.OrderID)">
                                <i class="bi bi-check-circle"></i> Accept
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeclineOrder(order.OrderID)">
                                <i class="bi bi-x-circle"></i> Decline
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">No actions available</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Order> orders;
    private List<Order> filteredOrders => GetFilteredOrders();
    private string currentTab = "pending";
    private string errorMessage;
    private string successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try 
        {
            orders = await OrderService.GetAllOrders();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching orders: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private List<Order> GetFilteredOrders()
    {
        if (orders == null) return new List<Order>();

        return currentTab switch
        {
            "pending" => orders.Where(o => o.Status == "Pending").ToList(),
            "done" => orders.Where(o => o.Status == "Accepted").ToList(),
            "declined" => orders.Where(o => o.Status == "Declined").ToList(),
            "all" => orders.ToList(),
            _ => orders.ToList()
        };
    }

    private void NavigateToTab(string tab)
    {
        currentTab = tab;
        StateHasChanged();
    }

    private async Task AcceptOrder(int orderId)
    {
        try
        {
            var result = await OrderService.UpdateOrderStatus(orderId, "Accepted");
            if (result == null)
            {
                successMessage = "Order accepted successfully!";
                errorMessage = null;
                await LoadOrders();
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Error accepting order: {result}";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            successMessage = null;
        }
    }

    private async Task DeclineOrder(int orderId)
    {
        try
        {
            var result = await OrderService.UpdateOrderStatus(orderId, "Declined");
            if (result == null)
            {
                successMessage = "Order declined successfully!";
                errorMessage = null;
                await LoadOrders();
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Error declining order: {result}";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            successMessage = null;
        }
    }
}
