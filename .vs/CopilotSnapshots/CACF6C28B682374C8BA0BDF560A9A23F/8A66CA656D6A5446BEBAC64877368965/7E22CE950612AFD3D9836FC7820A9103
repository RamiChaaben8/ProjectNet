@page "/admin/articles/edit/{id:int}"
@inject FrontEnd.Services.ArticleService ArticleService
@inject FrontEnd.Services.CategoryService CategoryService
@inject FrontEnd.Services.IImageUploadService ImageUploadService
@inject FrontEnd.Services.IAuthService AuthService
@inject NavigationManager NavigationManager
@using FrontEnd.Models
@using Microsoft.AspNetCore.Components.Forms

<div class="restaurant-admin-container">
    <div class="page-header">
        <h3><i class="bi bi-pencil-square"></i> Edit Menu Item</h3>
        <p class="subtitle">Update your dish information</p>
    </div>

    @if (article == null || categories == null)
    {
        <div class="loading-state">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading...</p>
        </div>
    }
    else
    {
        <div class="restaurant-card">
            <EditForm Model="@article" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="form-grid">
                    <div class="form-section full-width">
                        <label for="name" class="restaurant-label">
                            <i class="bi bi-cup-hot"></i> Dish Name
                        </label>
                        <InputText id="name" class="restaurant-input" @bind-Value="article.Name" />
                    </div>

                    <div class="form-section full-width">
                        <label for="description" class="restaurant-label">
                            <i class="bi bi-card-text"></i> Description
                        </label>
                        <InputTextArea id="description" class="restaurant-textarea" rows="4" @bind-Value="article.Description" />
                    </div>

                    <div class="form-section">
                        <label for="price" class="restaurant-label">
                            <i class="bi bi-currency-dollar"></i> Price
                        </label>
                        <InputNumber id="price" class="restaurant-input" @bind-Value="article.Price" />
                    </div>

                    <div class="form-section">
                        <label for="category" class="restaurant-label">
                            <i class="bi bi-bookmark"></i> Category
                        </label>
                        <InputSelect id="category" class="restaurant-select" @bind-Value="article.CategoryID">
                            <option value="0">-- Select Category --</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryID">@category.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-section full-width">
                        <label class="restaurant-label">
                            <i class="bi bi-image"></i> Dish Image
                        </label>
                        
                        <div class="image-upload-section">
                            <div class="upload-method-tabs">
                                <button type="button" 
                                        class="upload-tab @(uploadMethod == "file" ? "active" : "")" 
                                        @onclick='() => uploadMethod = "file"'>
                                    <i class="bi bi-upload"></i> Upload File
                                </button>
                                <button type="button" 
                                        class="upload-tab @(uploadMethod == "url" ? "active" : "")" 
                                        @onclick='() => uploadMethod = "url"'>
                                    <i class="bi bi-link-45deg"></i> Image URL
                                </button>
                            </div>

                            @if (uploadMethod == "file")
                            {
                                <div class="file-upload-area">
                                    <InputFile OnChange="HandleFileSelected" class="file-input" id="fileInput" accept="image/*" />
                                    <label for="fileInput" class="file-upload-label">
                                        <i class="bi bi-cloud-upload"></i>
                                        <span>@(string.IsNullOrEmpty(article.ImageUrl) ? "Click to upload" : "Click to replace image")</span>
                                        <small>PNG, JPG, GIF, WEBP up to 5MB</small>
                                    </label>
                                    
                                    @if (isUploading)
                                    {
                                        <div class="upload-progress">
                                            <div class="spinner-border text-warning spinner-border-sm me-2"></div>
                                            <span>Uploading image...</span>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(uploadError))
                                    {
                                        <div class="upload-error">
                                            <i class="bi bi-exclamation-triangle"></i> @uploadError
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="url-input-area">
                                    <InputText id="imageUrl" class="restaurant-input" 
                                               placeholder="https://example.com/dish-image.jpg" 
                                               @bind-Value="article.ImageUrl" />
                                    <small class="form-text">Paste a URL to an image of the dish</small>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(article.ImageUrl))
                    {
                        <div class="form-section full-width">
                            <div class="image-preview-container">
                                <div class="image-preview">
                                    <img src="@article.ImageUrl" alt="Preview" />
                                    <button type="button" class="remove-image-btn" @onclick="RemoveImage">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-exclamation-triangle"></i> @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i> @successMessage
                    </div>
                }

                <div class="action-buttons">
                    <button type="submit" class="btn-restaurant-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check-circle"></i> Update Item
                    </button>
                    <button type="button" class="btn-restaurant-secondary" @onclick="Cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

<style>
    /* Reuse the same styles from AddArticle.razor */
    .restaurant-admin-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        color: #2c3e50;
    }

    .page-header h3 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #d35400;
    }

    .page-header .subtitle {
        color: #7f8c8d;
        font-size: 16px;
    }

    .restaurant-card {
        background: white;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .form-section.full-width {
        grid-column: 1 / -1;
    }

    .restaurant-label {
        display: block;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 15px;
    }

    .restaurant-label i {
        color: #e67e22;
        margin-right: 8px;
    }

    .restaurant-input,
    .restaurant-textarea,
    .restaurant-select {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #ecf0f1;
        border-radius: 8px;
        font-size: 15px;
        transition: all 0.3s;
    }

    .restaurant-input:focus,
    .restaurant-textarea:focus,
    .restaurant-select:focus {
        outline: none;
        border-color: #e67e22;
        box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.1);
    }

    .form-text {
        display: block;
        margin-top: 5px;
        color: #95a5a6;
        font-size: 13px;
    }

    .image-upload-section {
        border: 2px dashed #ecf0f1;
        border-radius: 10px;
        padding: 20px;
        background: #f8f9fa;
    }

    .upload-method-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .upload-tab {
        flex: 1;
        padding: 10px 15px;
        border: 2px solid #ecf0f1;
        background: white;
        color: #7f8c8d;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .upload-tab:hover {
        border-color: #e67e22;
        color: #e67e22;
    }

    .upload-tab.active {
        background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
        color: white;
        border-color: #e67e22;
    }

    .file-upload-area {
        position: relative;
    }

    .file-input {
        display: none;
    }

    .file-upload-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        border: 2px dashed #bdc3c7;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        background: white;
    }

    .file-upload-label:hover {
        border-color: #e67e22;
        background: #fff5e6;
    }

    .file-upload-label i {
        font-size: 48px;
        color: #e67e22;
        margin-bottom: 15px;
    }

    .file-upload-label span {
        font-size: 16px;
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .file-upload-label small {
        color: #95a5a6;
        font-size: 13px;
    }

    .upload-progress, .upload-error {
        margin-top: 15px;
        padding: 10px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .upload-progress {
        background: #d4edda;
        color: #155724;
    }

    .upload-error {
        background: #f8d7da;
        color: #721c24;
    }

    .url-input-area {
        padding: 10px 0;
    }

    .image-preview-container {
        display: flex;
        justify-content: center;
    }

    .image-preview {
        position: relative;
        max-height: 400px;
        border-radius: 10px;
        overflow: hidden;
        background: #f8f9fa;
        display: inline-block;
    }

    .image-preview img {
        max-width: 100%;
        max-height: 400px;
        object-fit: contain;
        display: block;
    }

    .remove-image-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(231, 76, 60, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        transition: all 0.3s;
    }

    .remove-image-btn:hover {
        background: #e74c3c;
        transform: scale(1.1);
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        justify-content: center;
    }

    .btn-restaurant-primary,
    .btn-restaurant-secondary {
        padding: 14px 30px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-restaurant-primary {
        background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
        color: white;
    }

    .btn-restaurant-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(230, 126, 34, 0.3);
    }

    .btn-restaurant-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-restaurant-secondary {
        background: #ecf0f1;
        color: #2c3e50;
    }

    .btn-restaurant-secondary:hover {
        background: #bdc3c7;
    }

    .loading-state {
        text-align: center;
        padding: 60px 20px;
        color: #7f8c8d;
    }

    .loading-state .spinner-border {
        width: 3rem;
        height: 3rem;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .restaurant-card {
            padding: 25px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-restaurant-primary,
        .btn-restaurant-secondary {
            width: 100%;
        }

        .upload-method-tabs {
            flex-direction: column;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Article article;
    private List<Category> categories;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;
    private bool isUploading = false;
    private string uploadError = string.Empty;
    private string uploadMethod = "file";
    private string previousImageUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load both article and categories in parallel
            var articleTask = ArticleService.GetArticleById(Id);
            var categoriesTask = CategoryService.GetCategories();

            await Task.WhenAll(articleTask, categoriesTask);

            article = await articleTask;
            categories = await categoriesTask;
            previousImageUrl = article.ImageUrl;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = string.Empty;
        isUploading = true;

        try
        {
            var file = e.File;

            if (file.Size > 5 * 1024 * 1024) // 5MB limit
            {
                uploadError = "File size exceeds 5MB limit";
                isUploading = false;
                return;
            }

            // Read file as byte array
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).ReadAsync(buffer);

            // Upload to server
            var imageUrl = await ImageUploadService.UploadImageAsync(buffer, file.Name);

            if (!string.IsNullOrEmpty(imageUrl))
            {
                article.ImageUrl = imageUrl;
            }
            else
            {
                uploadError = "Failed to upload image. Please try again.";
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void RemoveImage()
    {
        article.ImageUrl = null;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Set Category to null to avoid validation error
            article.Category = null;
            
            var success = await ArticleService.UpdateArticle(article);
            
            if (success)
            {
                successMessage = "Menu item updated successfully!";
                await Task.Delay(1500); // Show success message briefly
                NavigationManager.NavigateTo("/admin/articles");
            }
            else
            {
                errorMessage = "Failed to update menu item. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/articles");
    }
}
