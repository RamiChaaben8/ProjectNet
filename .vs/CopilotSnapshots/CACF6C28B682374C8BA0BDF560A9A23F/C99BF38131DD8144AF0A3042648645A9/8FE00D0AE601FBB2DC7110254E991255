@page "/admin/articles/add"
@inject FrontEnd.Services.ArticleService ArticleService
@inject FrontEnd.Services.CategoryService CategoryService
@inject NavigationManager NavigationManager
@using FrontEnd.Models

<h3>Add New Article</h3>

@if (categories == null)
{
    <p><em>Loading categories...</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <EditForm Model="@newArticle" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Article Name</label>
                    <InputText id="name" class="form-control" @bind-Value="newArticle.Name" />
                    <ValidationMessage For="@(() => newArticle.Name)" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <InputTextArea id="description" class="form-control" rows="4" @bind-Value="newArticle.Description" />
                    <ValidationMessage For="@(() => newArticle.Description)" />
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <InputNumber id="price" class="form-control" @bind-Value="newArticle.Price" />
                    <ValidationMessage For="@(() => newArticle.Price)" />
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <InputSelect id="category" class="form-control" @bind-Value="newArticle.CategoryID">
                        <option value="0">-- Select Category --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryID">@category.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => newArticle.CategoryID)" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Create Article
                    </button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private AddArticleDTO newArticle = new AddArticleDTO();
    private List<Category> categories;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await CategoryService.GetCategories();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Convert DTO to Article entity
            var article = new Article
            {
                Name = newArticle.Name,
                Description = newArticle.Description,
                Price = newArticle.Price,
                CategoryID = newArticle.CategoryID,
                Category = null  // Explicitly set to null to avoid validation error
            };

            var success = await ArticleService.CreateArticle(article);
            
            if (success)
            {
                successMessage = "Article created successfully!";
                await Task.Delay(1500); // Show success message briefly
                NavigationManager.NavigateTo("/admin/articles");
            }
            else
            {
                errorMessage = "Failed to create article. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/articles");
    }
}
