using System.Net.Http.Json;
using System.Text.Json;
using Microsoft.JSInterop;

namespace FrontEnd.Services
{
    public interface IAuthService
    {
        Task<LoginResult> LoginAsync(string email, string password);
        Task<RegisterResult> RegisterAsync(string name, string email, string password, string phoneNumber);
        Task LogoutAsync();
        string? GetToken();
        string? GetRole();
        bool IsAuthenticated();
    }

    public class AuthService : IAuthService
    {
        private readonly HttpClient _httpClient;
        private readonly Microsoft.JSInterop.IJSRuntime _jsRuntime;
        private const string TokenKey = "authToken";
        private const string RoleKey = "userRole";

        public AuthService(HttpClient httpClient, Microsoft.JSInterop.IJSRuntime jsRuntime)
        {
            _httpClient = httpClient;
            _jsRuntime = jsRuntime;
        }

        public async Task<LoginResult> LoginAsync(string email, string password)
        {
            try
            {
                var loginData = new { Email = email, Password = password };
                var response = await _httpClient.PostAsJsonAsync("api/Account/login", loginData); // Ensure path is correct

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                    if (result != null)
                    {
                        await _jsRuntime.InvokeVoidAsync("localStorage.setItem", TokenKey, result.Token);
                        await _jsRuntime.InvokeVoidAsync("localStorage.setItem", RoleKey, result.Role);
                        await StoreAuthDataAsync(result.Token, result.Role);
                        return new LoginResult { Success = true, Role = result.Role };
                    }
                }

                var error = await response.Content.ReadAsStringAsync();
                return new LoginResult { Success = false, ErrorMessage = error };
            }
            catch (Exception ex)
            {
                return new LoginResult { Success = false, ErrorMessage = ex.Message };
            }
        }

        public async Task<RegisterResult> RegisterAsync(string name, string email, string password, string phoneNumber)
        {
            try
            {
                var registerData = new
                {
                    Name = name,
                    Email = email,
                    Password = password,
                    PhoneNumber = phoneNumber
                };

                var response = await _httpClient.PostAsJsonAsync("api/Account/client-register", registerData); // Ensure path is correct
                
                if (response.IsSuccessStatusCode)
                {
                    return new RegisterResult { Success = true };
                }
                
                var error = await response.Content.ReadAsStringAsync();
                return new RegisterResult { Success = false, ErrorMessage = error };
            }
            catch (Exception ex)
            {
                return new RegisterResult { Success = false, ErrorMessage = ex.Message };
            }
        }

        public async Task LogoutAsync()
        {
            await _jsRuntime.InvokeVoidAsync("localStorage.removeItem", TokenKey);
            await _jsRuntime.InvokeVoidAsync("localStorage.removeItem", RoleKey);
            _token = null;
            _role = null;
        }

        public string? GetToken() => _token;
        public string? GetRole() => _role;
        public bool IsAuthenticated() => !string.IsNullOrEmpty(_token);

        private static string? _token;
        private static string? _role;

        private Task StoreAuthDataAsync(string token, string role)
        {
            _token = token;
            _role = role;
            return Task.CompletedTask;
        }

        public async Task TryRestoreAuthAsync()
        {
            if (string.IsNullOrEmpty(_token))
            {
                try
                {
                    var token = await _jsRuntime.InvokeAsync<string>("localStorage.getItem", TokenKey);
                    var role = await _jsRuntime.InvokeAsync<string>("localStorage.getItem", RoleKey);
                    
                    if (!string.IsNullOrEmpty(token) && !string.IsNullOrEmpty(role))
                    {
                        await StoreAuthDataAsync(token, role);
                    }
                }
                catch
                {
                    // Ignore errors if JS interop fails (e.g. during prerendering)
                }
            }
        }
    }

    public class LoginResult
    {
        public bool Success { get; set; }
        public string? Role { get; set; }
        public string? ErrorMessage { get; set; }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    public class RegisterResult
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
