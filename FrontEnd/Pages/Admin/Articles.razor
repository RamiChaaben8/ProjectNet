@page "/admin/articles"
@inject FrontEnd.Services.ArticleService ArticleService
@inject NavigationManager NavigationManager
@using FrontEnd.Models

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Articles List</h3>
    <button class="btn btn-success" @onclick="NavigateToAddArticle">
        <i class="bi bi-plus-circle"></i> Add Article
    </button>
</div>

@if (articles == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (articles.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in articles)
                {
                    <tr>
                        <td>@article.Name</td>
                        <td>@article.Description</td>
                        <td>$@article.Price.ToString("F2")</td>
                        <td>@(article.Category?.Name ?? "N/A")</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => NavigateToEditArticle(article.ArticleID)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmation(article.ArticleID, article.Name)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No articles found.</p>
    }
}

@if (showDeleteDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete article <strong>@articleToDeleteName</strong>?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Article> articles;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool showDeleteDialog = false;
    private int articleToDeleteId;
    private string articleToDeleteName = string.Empty;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        try
        {
            articles = await ArticleService.GetArticles();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching articles: {ex.Message}");
            errorMessage = "Failed to load articles. Please try again.";
        }
    }

    private void NavigateToAddArticle()
    {
        NavigationManager.NavigateTo("/admin/articles/add");
    }

    private void NavigateToEditArticle(int articleId)
    {
        NavigationManager.NavigateTo($"/admin/articles/edit/{articleId}");
    }

    private void ShowDeleteConfirmation(int articleId, string articleName)
    {
        articleToDeleteId = articleId;
        articleToDeleteName = articleName;
        showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
        articleToDeleteId = 0;
        articleToDeleteName = string.Empty;
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var success = await ArticleService.DeleteArticle(articleToDeleteId);

            if (success)
            {
                successMessage = $"Article '{articleToDeleteName}' deleted successfully!";
                showDeleteDialog = false;

                // Refresh the articles list
                await LoadArticles();
            }
            else
            {
                errorMessage = "Failed to delete article. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            articleToDeleteId = 0;
            articleToDeleteName = string.Empty;
        }
    }
}
