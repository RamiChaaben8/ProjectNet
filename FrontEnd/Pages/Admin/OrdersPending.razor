@page "/admin/orders/pending"
@using FrontEnd.Models
@using FrontEnd.Services
@inject OrderService OrderService
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h3>Pending Orders</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else if (!orders.Any())
{
    <p><em>No pending orders.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Client Email</th>
                <th>Client Name</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.OrderDate.ToShortDateString()</td>
                    <td>@order.ClientEmail</td>
                    <td>@order.ClientName</td>
                    <td>$@order.TotalPrice.ToString("F2")</td>
                    <td><span class="badge bg-warning">@order.Status</span></td>
                    <td>
                        <button class="btn btn-success btn-sm me-2" @onclick="() => AcceptOrder(order.OrderID)">
                            <i class="bi bi-check-circle"></i> Accept
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeclineOrder(order.OrderID)">
                            <i class="bi bi-x-circle"></i> Decline
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Order> orders;
    private string errorMessage;
    private string successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try 
        {
            var allOrders = await OrderService.GetAllOrders();
            orders = allOrders?.Where(o => o.Status == "Pending").ToList() ?? new List<Order>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching orders: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private async Task AcceptOrder(int orderId)
    {
        try
        {
            var result = await OrderService.UpdateOrderStatus(orderId, "Accepted");
            if (result == null)
            {
                successMessage = "Order accepted successfully!";
                errorMessage = null;
                await LoadOrders();
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Error accepting order: {result}";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            successMessage = null;
        }
    }

    private async Task DeclineOrder(int orderId)
    {
        try
        {
            var result = await OrderService.UpdateOrderStatus(orderId, "Declined");
            if (result == null)
            {
                successMessage = "Order declined successfully!";
                errorMessage = null;
                await LoadOrders();
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Error declining order: {result}";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            successMessage = null;
        }
    }
}
