@page "/admin/categories/add"
@inject NavigationManager NavigationManager
@inject FrontEnd.Services.CategoryService CategoryService
@using FrontEnd.Models
@using FrontEnd.Services

<h3>Add Category</h3>

<EditForm Model="@newCategory" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="form-group">
        <label for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="newCategory.Name" />
        <ValidationMessage For="@(() => newCategory.Name)" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Submitting...</span>
        }
        else
        {
            <span>Add Category</span>
        }
    </button>
</EditForm>

<p><a href="/admin/categories">Back to Categories</a></p>

@code {
    private AddCategoryDTO newCategory = new AddCategoryDTO();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        try
        {
            var success = await CategoryService.CreateCategory(newCategory);
            if (success)
            {
                successMessage = "Category added successfully!";
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/admin/categories");
            }
            else
            {
                errorMessage = "Error adding category.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
